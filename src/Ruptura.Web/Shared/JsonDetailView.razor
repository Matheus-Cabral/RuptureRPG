@using System.Text.Json
@using Microsoft.Extensions.Localization
@using Ruptura.Web.Resources
@implements IDisposable
@inject IStringLocalizer<AppStrings> L

@if (_error)
{
    <pre class="detail-raw">@Json</pre>
}
else if (_doc is null || IsEmptyRoot())
{
    <p class="detail-empty">@L["Detail.None"]</p>
}
else
{
    <JsonValueView Node="_doc.RootElement" />
}

@code {
    [Parameter] public string? Json { get; set; }

    // JsonDocument (not JsonNode) so enumeration tolerates duplicate keys natively — a
    // duplicate-key blob can be persisted via the raw catalog textarea, and JsonNode throws
    // ArgumentException on first enumeration (during render, outside any try/catch). JsonElement
    // is a struct tied to this document's lifetime, so the document is held in a field and
    // disposed via IDisposable.
    private JsonDocument? _doc;
    private bool _error;

    protected override void OnParametersSet()
    {
        _error = false;
        _doc?.Dispose();
        _doc = null;
        if (string.IsNullOrWhiteSpace(Json)) return;
        try { _doc = JsonDocument.Parse(Json); }
        catch (JsonException) { _error = true; }
    }

    private bool IsEmptyRoot()
    {
        var root = _doc!.RootElement;
        if (root.ValueKind == JsonValueKind.Null) return true;
        if (root.ValueKind == JsonValueKind.Object)
        {
            foreach (var _ in root.EnumerateObject()) return false;
            return true;
        }
        return false;
    }

    public void Dispose() => _doc?.Dispose();
}
