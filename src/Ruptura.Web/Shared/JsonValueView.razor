@using System.Text.Json
@using Microsoft.Extensions.Localization
@using Ruptura.Web.Resources
@inject IStringLocalizer<AppStrings> L

@if (Node.ValueKind == JsonValueKind.Object)
{
    <dl class="detail-list">
        @foreach (var prop in Node.EnumerateObject())
        {
            <div class="detail-row">
                <dt class="detail-key">@Prettify(prop.Name)</dt>
                <dd class="detail-value"><JsonValueView Node="prop.Value" /></dd>
            </div>
        }
    </dl>
}
else if (Node.ValueKind == JsonValueKind.Array)
{
    @if (Node.GetArrayLength() == 0)
    {
        <span class="detail-value">—</span>
    }
    else
    {
        <ul class="detail-array">
            @foreach (var item in Node.EnumerateArray())
            {
                <li><JsonValueView Node="item" /></li>
            }
        </ul>
    }
}
else
{
    <span>@Scalar(Node)</span>
}

@code {
    [Parameter] public JsonElement Node { get; set; }

    // camelCase / PascalCase / snake_case -> spaced Title Case.
    private static string Prettify(string key)
    {
        if (string.IsNullOrEmpty(key)) return key;
        var spaced = System.Text.RegularExpressions.Regex.Replace(key.Replace('_', ' '), "(?<=[a-z0-9])(?=[A-Z])", " ");
        return char.ToUpperInvariant(spaced[0]) + spaced[1..];
    }

    private string Scalar(JsonElement node)
    {
        switch (node.ValueKind)
        {
            case JsonValueKind.True:
                return L["Common.Yes"];
            case JsonValueKind.False:
                return L["Common.No"];
            case JsonValueKind.Number:
                return node.GetRawText();
            case JsonValueKind.String:
                var s = node.GetString();
                return string.IsNullOrWhiteSpace(s) ? "—" : s;
            case JsonValueKind.Null:
            case JsonValueKind.Undefined:
                return "—";
            default:
                return node.GetRawText();
        }
    }
}
