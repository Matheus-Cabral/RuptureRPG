@using System.Text.Json
@using Microsoft.Extensions.Localization
@using Ruptura.Shared.Auth
@using Ruptura.Web.Resources
@inject IStringLocalizer<AppStrings> L
@inject IAuthClientService AuthService
@inject NavigationManager Nav
@inject ToastService Toast

@* Non-dismissible on purpose: the API rejects every other request while the account is on a
   temporary password, so there is nothing behind this dialog to go back to. *@
<div class="confirm-overlay">
    <div class="confirm-box" role="dialog" aria-modal="true" aria-labelledby="force-pw-title">
        <h2 class="confirm-title" id="force-pw-title">@L["ForcePassword.Title"]</h2>
        <p class="confirm-message">@L["ForcePassword.Message"]</p>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert-danger mb-4" role="alert">@_error</div>
        }

        <EditForm Model="_model" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />

            <div class="auth-field">
                <label class="form-label" for="force-pw-new">@L["ForcePassword.NewPassword"]</label>
                <InputText id="force-pw-new" class="form-control" @bind-Value="_model.NewPassword"
                           type="password" autocomplete="new-password" @ref="_newPasswordRef" />
                <ValidationMessage For="() => _model.NewPassword" />
                <p class="password-hint">@L["Register.PasswordHint"]</p>
            </div>

            <div class="auth-field">
                <label class="form-label" for="force-pw-confirm">@L["ForcePassword.ConfirmPassword"]</label>
                <InputText id="force-pw-confirm" class="form-control" @bind-Value="_model.ConfirmNewPassword"
                           type="password" autocomplete="new-password" />
                <ValidationMessage For="() => _model.ConfirmNewPassword" />
            </div>

            <div class="confirm-actions">
                <button type="button" class="btn btn-outline-secondary btn-sm"
                        disabled="@_submitting" @onclick="SignOutAsync">@L["Nav.Logout"]</button>
                <button type="submit" class="btn btn-primary btn-sm" disabled="@_submitting">
                    @if (_submitting) { <span class="spinner-border spinner-border-sm me-2"></span> }
                    @L["ForcePassword.Submit"]
                </button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private readonly ChangePasswordRequest _model = new();
    private InputText? _newPasswordRef;
    private string? _error;
    private bool _submitting;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _newPasswordRef?.Element is { } element)
            await element.FocusAsync();
    }

    private async Task HandleSubmit()
    {
        _submitting = true;
        _error = null;

        try
        {
            var result = await AuthService.ChangePasswordAsync(_model);

            // On success the tokens are already persisted and the auth state has changed, which
            // makes MainLayout drop this dialog and re-render the page under the new token.
            if (result?.Data is not null)
                Toast.Success(L["ForcePassword.Success"]);
            else
                _error = result?.Message ?? L["Common.Error"];
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException or NotSupportedException)
        {
            _error = L["Common.Error"];
        }

        _submitting = false;
    }

    private async Task SignOutAsync()
    {
        await AuthService.LogoutAsync();
        Nav.NavigateTo("/login");
    }
}
