@using Microsoft.Extensions.Localization
@using Ruptura.Web.Resources
@inject LightboxService Lightbox
@inject IStringLocalizer<AppStrings> L
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (Lightbox.CurrentImage is { } image)
{
    <div class="lightbox-overlay" @onclick="Lightbox.Close" @onkeydown="OnKeyDown" tabindex="-1" @ref="_overlayRef"
         role="dialog" aria-modal="true" aria-label="@DialogLabel">
        <button class="lightbox-close" @ref="_closeRef" @onclick="Lightbox.Close" @onclick:stopPropagation="true" aria-label="@L["Common.Close"]">✕</button>
        <img class="lightbox-img" src="@image" alt="@(Lightbox.CurrentAlt ?? string.Empty)" @onclick:stopPropagation="true" />
    </div>
}

@code {
    private ElementReference _overlayRef;
    private ElementReference _closeRef;
    private bool _wasOpen;

    protected override void OnInitialized() => Lightbox.OnChange += HandleChange;

    private void HandleChange() => InvokeAsync(StateHasChanged);

    private string DialogLabel =>
        string.IsNullOrWhiteSpace(Lightbox.CurrentAlt) ? L["Common.ImagePreview"] : Lightbox.CurrentAlt!;

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") Lightbox.Close();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var isOpen = Lightbox.CurrentImage is not null;
        if (isOpen && !_wasOpen)
        {
            // Lock body scroll + trap Tab inside the overlay, then focus the close button.
            await JS.InvokeVoidAsync("ruptura.openLightbox", _overlayRef);
            await _closeRef.FocusAsync();
        }
        else if (!isOpen && _wasOpen)
        {
            await JS.InvokeVoidAsync("ruptura.closeLightbox");
        }
        _wasOpen = isOpen;
    }

    public async ValueTask DisposeAsync()
    {
        Lightbox.OnChange -= HandleChange;

        // Defensive: this component is mounted once in MainLayout and never torn down in normal
        // SPA navigation, so this path is effectively dead today — but if that ever changes and
        // disposal happens mid-open, release the focus trap + body scroll lock rather than leak them.
        if (_wasOpen)
        {
            try
            {
                await JS.InvokeVoidAsync("ruptura.closeLightbox");
            }
            catch (JSDisconnectedException)
            {
                // circuit already gone — nothing to clean up client-side
            }
        }
    }
}
