@using Microsoft.Extensions.Localization
@using Ruptura.Web.Resources
@inject IStringLocalizer<AppStrings> L
@inject IAuthClientService AuthService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider

<nav class="sidebar-nav">
    <AuthorizeView>
        <Authorized>
            <span class="nav-label">@L["Nav.Dashboard"]</span>
            <div class="nav-item">
                <NavLink class="nav-link" href="/dashboard" Match="NavLinkMatch.All">
                    🏠 @L["Nav.Dashboard"]
                </NavLink>
            </div>

            <AuthorizeView Roles="GameMaster">
                <Authorized Context="gmCtx">
                    <span class="nav-label">Game Master</span>
                    <div class="nav-item">
                        <NavLink class="nav-link" href="/gm/invites">
                            🎫 @L["Nav.Invites"]
                        </NavLink>
                    </div>
                </Authorized>
            </AuthorizeView>

            <div class="nav-item mt-auto">
                <button class="nav-link btn btn-link w-100 text-start" @onclick="LogoutAsync">
                    🚪 @L["Nav.Logout"]
                </button>
            </div>
        </Authorized>
        <NotAuthorized>
            <div class="nav-item">
                <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">
                    🏠 @L["Nav.Home"]
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="/login">
                    🔑 @L["Nav.Login"]
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="/register">
                    ✨ @L["Nav.Register"]
                </NavLink>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</nav>

@code {
    private async Task LogoutAsync()
    {
        await AuthService.LogoutAsync();
        Nav.NavigateTo("/login");
    }
}
