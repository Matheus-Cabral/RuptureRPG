@using Microsoft.Extensions.Localization
@using Ruptura.Web.Resources
@inject IStringLocalizer<AppStrings> L
@inject IAuthClientService AuthService
@inject NavigationManager Nav

<nav class="sidebar-nav">
    <AuthorizeView>
        <Authorized>
            <span class="nav-section-label">@L["Nav.Dashboard"]</span>
            <NavLink class="nav-link" href="/dashboard" Match="NavLinkMatch.All">
                @L["Nav.Dashboard"]
            </NavLink>

            <AuthorizeView Roles="Player">
                <Authorized Context="playerCtx">
                    <NavLink class="nav-link" href="/campaigns">
                        @L["Nav.Campaigns.Player"]
                    </NavLink>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView Roles="GameMaster">
                <Authorized Context="gmCtx">
                    <span class="nav-section-label" style="margin-top:.75rem">Mestre</span>
                    <NavLink class="nav-link" href="/gm/players">
                        @L["Nav.Players"]
                    </NavLink>
                    <NavLink class="nav-link" href="/gm/campaigns">
                        @L["Nav.Campaigns"]
                    </NavLink>
                </Authorized>
            </AuthorizeView>

            <div style="flex:1"></div>
            <button class="nav-btn-link" @onclick="LogoutAsync">
                @L["Nav.Logout"]
            </button>
        </Authorized>
        <NotAuthorized>
            <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">
                @L["Nav.Home"]
            </NavLink>
            <NavLink class="nav-link" href="/login">
                @L["Nav.Login"]
            </NavLink>
            <NavLink class="nav-link" href="/register">
                @L["Nav.Register"]
            </NavLink>
        </NotAuthorized>
    </AuthorizeView>
</nav>

@code {
    private async Task LogoutAsync()
    {
        await AuthService.LogoutAsync();
        Nav.NavigateTo("/login");
    }
}
