@using Microsoft.Extensions.Localization
@using Ruptura.Web.Resources
@inject IStringLocalizer<AppStrings> L

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    <RedirectToLogin />
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>404 — RUPTURA</PageTitle>
            <LayoutView Layout="@typeof(MainLayout)">
                <div class="page-heading">
                    <h1>404</h1>
                    <p>@L["NotFound.Title"]</p>
                </div>
                <AuthorizeView>
                    <Authorized>
                        <a href="/dashboard" class="btn btn-outline-secondary btn-sm">@L["NotFound.BackToDashboard"]</a>
                    </Authorized>
                    <NotAuthorized>
                        <a href="/" class="btn btn-outline-secondary btn-sm">@L["NotFound.Back"]</a>
                    </NotAuthorized>
                </AuthorizeView>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
