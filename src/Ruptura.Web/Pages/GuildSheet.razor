@page "/campaigns/{CampaignId:guid}/guild"
@attribute [Authorize]
@implements IDisposable
@using Microsoft.Extensions.Localization
@using Ruptura.Web.Resources
@using Ruptura.Shared.Guilds
@inject IStringLocalizer<AppStrings> L
@inject ICampaignClientService CampaignService
@inject IGuildClientService GuildService
@inject IMediaClientService MediaService
@inject ToastService Toast
@inject AuthenticationStateProvider AuthState

<PageTitle>@(_guild?.GuildName ?? L["Guild.Title"]) — RUPTURA</PageTitle>

<div class="page-content">
    <Breadcrumbs Items="_breadcrumbs" />

    @if (_loading)
    {
        <LoadingIndicator Text="@L["Guild.Loading"]" />
    }
    else if (_guild is null)
    {
        <div class="ledger-empty"><p>@L["Guild.LoadError"]</p></div>
    }
    else
    {
        @if (_conflict)
        {
            <div class="alert-danger" style="display:flex;gap:1rem;align-items:center;justify-content:space-between;margin-bottom:1rem">
                <span>@L["Guild.Autosave.ConflictBanner"]</span>
                <button class="btn btn-outline-secondary btn-sm" @onclick="ReloadAfterConflictAsync">
                    @L["Guild.Autosave.Reload"]
                </button>
            </div>
        }

        <div style="display:flex;flex-wrap:wrap;gap:1rem;align-items:flex-end;margin-bottom:1.5rem">
            <div>
                <label class="form-label">@L["Guild.NameLabel"]</label>
                <input class="form-control" @bind="_guildName" @bind:event="oninput" />
            </div>
            <div>
                <label class="form-label">@L["Guild.EmblemLabel"]</label>
                <ImageSlot DataUri="@_emblemDataUri" Uploading="_uploadingEmblem"
                           Alt="@_guildName" OnFilePicked="UploadEmblemAsync" />
            </div>
            <button class="btn btn-primary btn-sm" @onclick="SaveAsync" disabled="@_saving">
                @if (_saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                @L["Guild.Save"]
            </button>
            <span class="section-title">@AutosaveStatusText()</span>
        </div>

        <ul class="nav nav-tabs guild-tab-strip">
            @foreach (var tab in Tabs)
            {
                <li class="nav-item">
                    <button class="nav-link @(_activeTab == tab.Key ? "active" : "")" @onclick="() => _activeTab = tab.Key">
                        @L[tab.Value]
                    </button>
                </li>
            }
        </ul>

        <div style="padding:1.5rem 0">
            @if (_activeTab == "capacities")
            {
                <GuildCapacitiesPanel Stats="_guild.DerivedStats" />
            }
            else if (_activeTab == "identity")
            {
                <GuildIdentityTab Data="_data" CampaignId="CampaignId" />
            }
            else if (_activeTab == "buildings")
            {
                <GuildBuildingsTab CampaignId="CampaignId" Guild="_guild" OnChanged="RefreshBuildingsAsync" />
            }
            else if (_activeTab == "staff")
            {
                <GuildStaffTab CampaignId="CampaignId" Staff="_guild.Staff" OnChanged="RefreshStaffAsync" />
            }
            else if (_activeTab == "doctrines")
            {
                <GuildDoctrinesTab Data="_data" Stats="_guild.DerivedStats" CampaignId="CampaignId" />
            }
            else if (_activeTab == "resources")
            {
                <GuildResourcesTab Data="_data" />
            }
            else if (_activeTab == "influence")
            {
                <GuildInfluenceTab Data="_data" />
            }
            else if (_activeTab == "knowledge")
            {
                <GuildKnowledgeTab Data="_data" />
            }
            else if (_activeTab == "research")
            {
                <GuildResearchTab CampaignId="CampaignId" Research="_guild.Research" OnChanged="RefreshResearchAsync" />
            }
            else if (_activeTab == "crafting")
            {
                <GuildCraftingTab CampaignId="CampaignId" Crafting="_guild.Crafting" OnChanged="RefreshCraftingAsync" />
            }
            else if (_activeTab == "legacy")
            {
                <GuildLegacyTab Data="_data" />
            }
            else if (_activeTab == "expeditions")
            {
                <GuildExpeditionsTab CampaignId="CampaignId" Expeditions="_guild.Expeditions" OnChanged="RefreshExpeditionsAsync" />
            }
            else if (_activeTab == "interlude")
            {
                <GuildInterludeTab CampaignId="CampaignId" GuildVersion="_guild.Version" OnGuildReplaced="ReplaceGuild" />
            }
        </div>
    }
</div>

@code {
    [Parameter] public Guid CampaignId { get; set; }

    private static readonly Dictionary<string, string> Tabs = new()
    {
        ["capacities"] = "Guild.Tab.Capacities",
        ["identity"] = "Guild.Tab.Identity",
        ["buildings"] = "Guild.Tab.Buildings",
        ["staff"] = "Guild.Tab.Staff",
        ["doctrines"] = "Guild.Tab.Doctrines",
        ["resources"] = "Guild.Tab.Resources",
        ["influence"] = "Guild.Tab.Influence",
        ["knowledge"] = "Guild.Tab.Knowledge",
        ["research"] = "Guild.Tab.Research",
        ["crafting"] = "Guild.Tab.Crafting",
        ["legacy"] = "Guild.Tab.Legacy",
        ["expeditions"] = "Guild.Tab.Expeditions",
        ["interlude"] = "Guild.Tab.Interlude"
    };

    private GuildSheetResponse? _guild;
    private GuildSheetData _data = new();
    private List<BreadcrumbItem> _breadcrumbs = [];
    private string _guildName = string.Empty;
    private string? _emblemDataUri;
    private bool _uploadingEmblem;
    private bool _loading = true;
    private bool _saving;
    private string _activeTab = "capacities";

    private AutosaveWatcher? _autosave;
    private AutosaveStatus _autosaveState = AutosaveStatus.Idle;
    private DateTime? _lastSavedAt;
    private bool _conflict;
    private bool _autosaveInFlight;

    protected override async Task OnInitializedAsync()
    {
        var campaignsResult = await CampaignService.GetMineAsync();
        var campaignName = campaignsResult?.Data?.FirstOrDefault(c => c.Id == CampaignId)?.Name;

        // The guild page is shared by GMs and players, so the campaigns crumb must be role-aware:
        // GMs go to /gm/campaigns ("Campaigns"); players go to /dashboard ("Painel" — the
        // player's campaign list lives on their dashboard, there's no separate /campaigns page).
        var state = await AuthState.GetAuthenticationStateAsync();
        var isGm = state.User.FindFirst("role")?.Value == "GameMaster";
        var campaignsCrumb = isGm
            ? new BreadcrumbItem(L["Nav.Campaigns"], "/gm/campaigns")
            : new BreadcrumbItem(L["Nav.Dashboard"], "/dashboard");
        _breadcrumbs =
        [
            campaignsCrumb,
            new BreadcrumbItem(campaignName ?? L["Guild.Title"], null)
        ];

        await LoadGuildAsync();
        _loading = false;

        if (_guild is not null)
        {
            _autosave = new AutosaveWatcher(TimeSpan.FromSeconds(1.5), Snapshot, AutosaveAsync);
            _autosave.Start();
        }
    }

    private string Snapshot() => $"{_guildName}|{System.Text.Json.JsonSerializer.Serialize(_data)}";

    private async Task LoadGuildAsync()
    {
        var result = await GuildService.GetGuildAsync(CampaignId);
        _guild = result?.Data;
        if (_guild is null)
        {
            Toast.Error(result?.Message ?? L["Guild.LoadError"]);
            return;
        }

        _data = _guild.Data;
        _guildName = _guild.GuildName;
        _emblemDataUri = await MediaService.GetDataUriAsync(_data.Identity.EmblemImagePath);
    }

    // Child-row mutations (expedition/building/staff/research/crafting) do NOT bump the guild blob's
    // xmin, so the user's load-time _guild.Version stays valid through any number of them. These
    // refreshes therefore NEVER touch _guild.Version: adopting refreshed.Data.Version here would mean
    // silently swallowing a CONCURRENT blob save (the only thing that moves xmin) while keeping the
    // now-stale local _data — exactly the lost update the token exists to prevent. The next blob Save
    // will 409 correctly if such a concurrent write happened; a user who only manages child entities
    // never PUTs the blob and so never sees a spurious 409.
    private async Task RefreshExpeditionsAsync()
    {
        if (_guild is null) return;
        var refreshed = await GuildService.GetGuildAsync(CampaignId);
        if (refreshed?.Data is not null)
            _guild.Expeditions = refreshed.Data.Expeditions;
    }

    // Refresh the buildings list and the recomputed derived stats (capacities/overflow shift) —
    // never _data/_guildName (unsaved blob/name edits) and never _guild.Version (see above).
    private async Task RefreshBuildingsAsync()
    {
        if (_guild is null) return;
        var refreshed = await GuildService.GetGuildAsync(CampaignId);
        if (refreshed?.Data is not null)
        {
            _guild.Buildings = refreshed.Data.Buildings;
            _guild.DerivedStats = refreshed.Data.DerivedStats;
        }
    }

    // Same targeted-refresh rule for staff (maintenance/worker-income shift on the derived stats).
    private async Task RefreshStaffAsync()
    {
        if (_guild is null) return;
        var refreshed = await GuildService.GetGuildAsync(CampaignId);
        if (refreshed?.Data is not null)
        {
            _guild.Staff = refreshed.Data.Staff;
            _guild.DerivedStats = refreshed.Data.DerivedStats;
        }
    }

    // Research mutations shift the CG Pesquisa capacity (completed projects add Points), so refresh
    // the derived stats alongside the list — never _data/_guildName or _guild.Version.
    private async Task RefreshResearchAsync()
    {
        if (_guild is null) return;
        var refreshed = await GuildService.GetGuildAsync(CampaignId);
        if (refreshed?.Data is not null)
        {
            _guild.Research = refreshed.Data.Research;
            _guild.DerivedStats = refreshed.Data.DerivedStats;
        }
    }

    // Crafting has no derived-stat impact, but keep the same targeted-refresh shape for consistency.
    private async Task RefreshCraftingAsync()
    {
        if (_guild is null) return;
        var refreshed = await GuildService.GetGuildAsync(CampaignId);
        if (refreshed?.Data is not null)
        {
            _guild.Crafting = refreshed.Data.Crafting;
            _guild.DerivedStats = refreshed.Data.DerivedStats;
        }
    }

    // Interlude Apply mutates server state and returns the whole refreshed guild — adopt it wholesale
    // (new DerivedStats/Version/child lists). We ALSO adopt the Resources blob module, because a
    // Maintenance/Income apply mutates Resources.Silver server-side: without this, _data would still
    // point at the pre-apply blob, and the next Save would PUT that stale blob under the bumped Version
    // (which passes the xmin check) and silently revert the deduction. The rest of _data and
    // _guildName are left untouched so unsaved edits in other blob tabs survive.
    private void ReplaceGuild(GuildSheetResponse refreshed)
    {
        _guild = refreshed;
        _data.Resources = refreshed.Data.Resources;
        // The apply read fresh server state and is version-aware (it 409s if the client's version was
        // stale), so refreshed.Version is current and _guild adopts it wholesale above. The next Save
        // carries that adopted version and stays correct.
    }

    // Manual save and autosave share `_saving`/`_autosaveInFlight` as a mutual-exclusion pair —
    // without it, a manual click could fire while an autosave tick is mid-request; both PUT the
    // same blob concurrently under the same `_guild.Version`, and whichever the server processes
    // second 409s against the version the first one just bumped — a spurious "someone else
    // edited this" conflict that was actually just this page racing itself. Neither path adopts
    // `result.Response.Data.Data`/`GuildName` wholesale (only Version + DerivedStats, in place on
    // the existing `_guild`) for the same reason as the character sheet: `_data`/`_guildName` are
    // the live objects every tab component is bound to, and swapping them for the server's echo
    // of the pre-request snapshot would revert any keystrokes typed while the request was in flight.
    private async Task SaveAsync()
    {
        if (_guild is null || _saving || _autosaveInFlight) return;

        _saving = true;

        try
        {
            var result = await GuildService.UpdateGuildAsync(CampaignId, new UpdateGuildSheetRequest
            {
                GuildName = _guildName,
                DataJson = System.Text.Json.JsonSerializer.Serialize(_data),
                Version = _guild.Version
            });

            if (result.Response?.Data is not null)
            {
                _guild.Version = result.Response.Data.Version;
                _guild.DerivedStats = result.Response.Data.DerivedStats;
                _autosave?.MarkSaved();
                _lastSavedAt = DateTime.Now;
                _autosaveState = AutosaveStatus.Saved;
                Toast.Success(L["Guild.Saved"]);
            }
            else if (result.IsConflict)
            {
                // Manual save now goes through the same non-destructive conflict path as
                // autosave (see AutosaveAsync) instead of silently reloading over the user's
                // edit — a manual click racing another editor's save is the same situation.
                _conflict = true;
                _autosaveState = AutosaveStatus.Idle;
            }
            else
            {
                Toast.Error(result.Response?.Message ?? L["Common.Error"]);
            }
        }
        finally
        {
            _saving = false;
            StateHasChanged();
        }
    }

    // Fires from AutosaveWatcher's background poll — no toast (would spam every ~1.5s of active
    // editing), just the inline status text. Deliberately does NOT adopt `result.Response.Data`
    // into `_data`/`_guildName`: those are the live objects every tab component is bound to, and
    // if the user kept typing while this request was in flight, swapping in the server's echo of
    // the *pre-keystroke* snapshot would visibly revert them. `Version` and `DerivedStats` ARE
    // adopted — Version because the next save (auto or manual) must carry the fresh xmin or it
    // will spuriously 409 against its own prior autosave; DerivedStats because it's read-only
    // display that should update live without the player clicking Save.
    private async Task AutosaveAsync()
    {
        if (_guild is null || _conflict || _saving || _autosaveInFlight) return;

        _autosaveInFlight = true;
        _autosaveState = AutosaveStatus.Saving;
        await InvokeAsync(StateHasChanged);

        try
        {
            var result = await GuildService.UpdateGuildAsync(CampaignId, new UpdateGuildSheetRequest
            {
                GuildName = _guildName,
                DataJson = System.Text.Json.JsonSerializer.Serialize(_data),
                Version = _guild.Version
            });

            if (result.Response?.Data is not null)
            {
                _guild.Version = result.Response.Data.Version;
                _guild.DerivedStats = result.Response.Data.DerivedStats;
                _autosave?.MarkSaved();
                _lastSavedAt = DateTime.Now;
                _autosaveState = AutosaveStatus.Saved;
            }
            else if (result.IsConflict)
            {
                // Someone else saved first — their write is safe. Stop retrying (every subsequent
                // tick would just 409 again on the same stale Version) and let the user decide when
                // to discard their own in-progress edit by reloading, instead of doing it for them.
                _conflict = true;
                _autosaveState = AutosaveStatus.Idle;
            }
            else
            {
                _autosaveState = AutosaveStatus.Error;
            }
        }
        catch (Exception)
        {
            // A network/deserialization exception must still land in Error, not leave the status
            // stuck on "Saving…" forever — AutosaveWatcher's own catch only protects the polling
            // loop itself, it doesn't know about this page's status field.
            _autosaveState = AutosaveStatus.Error;
        }
        finally
        {
            _autosaveInFlight = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ReloadAfterConflictAsync()
    {
        await LoadGuildAsync();
        _conflict = false;
        _autosaveState = AutosaveStatus.Idle;
        _autosave?.ResetBaseline();
    }

    private string AutosaveStatusText() => _autosaveState switch
    {
        AutosaveStatus.Saving => L["Guild.Autosave.Saving"],
        AutosaveStatus.Saved when _lastSavedAt is not null =>
            string.Format(L["Guild.Autosave.SavedAt"], _lastSavedAt.Value.ToString("HH:mm")),
        AutosaveStatus.Error => L["Guild.Autosave.Error"],
        _ => string.Empty
    };

    public void Dispose() => _autosave?.Dispose();

    private async Task UploadEmblemAsync(InputFileChangeEventArgs e)
    {
        if (_guild is null) return;

        _uploadingEmblem = true;

        try
        {
            await using var stream = e.File.OpenReadStream(maxAllowedSize: Ruptura.Shared.Media.MediaLimits.ClientMaxUploadBytes);
            var result = await MediaService.UploadEmblemAsync(stream, e.File.Name, _guild.Id, _guild.Version);

            if (result.Response?.Data is not null)
            {
                _data.Identity.EmblemImagePath = result.Response.Data.Path;
                _emblemDataUri = await MediaService.GetDataUriAsync(_data.Identity.EmblemImagePath);
                // The upload bumped the row's xmin and returned the new token — adopt it in place
                // (keeping in-progress _data/_guildName edits) so the next Save doesn't spuriously
                // 409. No re-GET, which would clobber those edits.
                if (result.Response.Data.Version is { } newVersion) _guild.Version = newVersion;
                Toast.Success(L["Guild.EmblemUploaded"]);
            }
            else if (result.IsConflict)
            {
                // Someone else advanced the guild between our last load and this upload — the emblem
                // write was rejected server-side (file cleaned up there). Reload the latest state.
                Toast.Error(L["Guild.Conflict"]);
                await LoadGuildAsync();
            }
            else
            {
                Toast.Error(result.Response?.Message ?? L["Common.Error"]);
            }
        }
        catch (Exception)
        {
            Toast.Error(L["Common.Error"]);
        }
        finally
        {
            _uploadingEmblem = false;
        }
    }
}
