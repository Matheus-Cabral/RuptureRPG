@using Microsoft.Extensions.Localization
@using Ruptura.Web.Resources
@using Ruptura.Shared.CharacterSheets
@using Ruptura.Shared.Catalog
@inject IStringLocalizer<AppStrings> L
@inject ICatalogClientService CatalogService

@if (_loading)
{
    <LoadingIndicator Text="@L["Common.Loading"]" />
}
else
{
<div style="display:flex;flex-direction:column;gap:1rem;max-width:480px">
    <div>
        <label class="form-label">@L["Sheet.Identity.Origin"]</label>
        <SearchableSelect TValue="Guid?" Options="@ToOptions(_originOptions)" NoneLabel="@L["Sheet.Identity.None"]"
                          Value="Data.Identity.OriginId" ValueChanged="v => Data.Identity.OriginId = v" />
    </div>
    <div>
        <label class="form-label">@L["Sheet.Identity.Background"]</label>
        <SearchableSelect TValue="Guid?" Options="@ToOptions(_backgroundOptions)" NoneLabel="@L["Sheet.Identity.None"]"
                          Value="Data.Identity.BackgroundId" ValueChanged="v => Data.Identity.BackgroundId = v" />
    </div>
    <div>
        <label class="form-label">@L["Sheet.Identity.Lineage"]</label>
        <SearchableSelect TValue="Guid?" Options="@ToOptions(_lineageOptions)" NoneLabel="@L["Sheet.Identity.None"]"
                          Value="Data.Identity.LineageId" ValueChanged="v => Data.Identity.LineageId = v" />
    </div>
    <div>
        <label class="form-label">@L["Sheet.Identity.Aptitudes"]</label>
        @foreach (var entry in _aptitudeOptions)
        {
            var id = entry.Id;
            <div class="form-check">
                <input class="form-check-input" type="checkbox" checked="@Data.Identity.AptitudeIds.Contains(id)"
                       @onchange="e => ToggleAptitude(id, (bool)(e.Value ?? false))" />
                <label class="form-check-label">@entry.Name</label>
            </div>
        }
    </div>
    <div>
        <label class="form-label">@L["Sheet.Identity.InitialTalent"]</label>
        <SearchableSelect TValue="Guid?" Options="@ToOptions(_initialTalentOptions)" NoneLabel="@L["Sheet.Identity.None"]"
                          Value="Data.Identity.InitialTalentId" ValueChanged="v => Data.Identity.InitialTalentId = v" />
    </div>
    <div>
        <label class="form-label">@L["Sheet.Identity.Patron"]</label>
        <input class="form-control" @bind="Data.Identity.PatronDisplayName" @bind:event="oninput" />
    </div>
</div>
}

@code {
    [Parameter] public CharacterSheetData Data { get; set; } = new();
    [Parameter] public Guid CampaignId { get; set; }

    // Full lists (including archived) fetched once. Each *Options computed property below
    // filters archived entries OUT except for whichever one is currently selected on this
    // sheet — otherwise a picker bound to an archived id has no matching option and displays
    // "— none —", which looks like nothing is set even though Data still holds the real
    // (archived) id underneath.
    private List<CatalogEntryResponse> _origins = [];
    private List<CatalogEntryResponse> _backgrounds = [];
    private List<CatalogEntryResponse> _lineages = [];
    private List<CatalogEntryResponse> _aptitudes = [];
    private List<CatalogEntryResponse> _talents = [];
    private bool _loading = true;

    private IEnumerable<CatalogEntryResponse> _originOptions =>
        _origins.Where(e => !e.IsArchived || e.Id == Data.Identity.OriginId);
    private IEnumerable<CatalogEntryResponse> _backgroundOptions =>
        _backgrounds.Where(e => !e.IsArchived || e.Id == Data.Identity.BackgroundId);
    private IEnumerable<CatalogEntryResponse> _lineageOptions =>
        _lineages.Where(e => !e.IsArchived || e.Id == Data.Identity.LineageId);
    private IEnumerable<CatalogEntryResponse> _aptitudeOptions =>
        _aptitudes.Where(e => !e.IsArchived || Data.Identity.AptitudeIds.Contains(e.Id));
    private IEnumerable<CatalogEntryResponse> _initialTalentOptions =>
        _talents.Where(e => !e.IsArchived || e.Id == Data.Identity.InitialTalentId);

    protected override async Task OnInitializedAsync()
    {
        _origins = (await CatalogService.GetByTypeAsync("Origin", CampaignId, includeArchived: true))?.Data?.ToList() ?? [];
        _backgrounds = (await CatalogService.GetByTypeAsync("Background", CampaignId, includeArchived: true))?.Data?.ToList() ?? [];
        _lineages = (await CatalogService.GetByTypeAsync("Lineage", CampaignId, includeArchived: true))?.Data?.ToList() ?? [];
        _aptitudes = (await CatalogService.GetByTypeAsync("Aptitude", CampaignId, includeArchived: true))?.Data?.ToList() ?? [];
        _talents = (await CatalogService.GetByTypeAsync("Talent", CampaignId, includeArchived: true))?.Data?.ToList() ?? [];
        _loading = false;
    }

    private static IEnumerable<SearchableOption<Guid?>> ToOptions(IEnumerable<CatalogEntryResponse> entries) =>
        entries.Select(e => new SearchableOption<Guid?>(e.Id, e.Name));

    private void ToggleAptitude(Guid id, bool isChecked)
    {
        if (isChecked && !Data.Identity.AptitudeIds.Contains(id) && Data.Identity.AptitudeIds.Count < 2)
            Data.Identity.AptitudeIds.Add(id);
        else if (!isChecked)
            Data.Identity.AptitudeIds.Remove(id);
    }
}
