@page "/gm/players"
@attribute [Authorize(Roles = "GameMaster")]
@using Microsoft.Extensions.Localization
@using Ruptura.Web.Resources
@using Ruptura.Shared.Campaigns
@inject IStringLocalizer<AppStrings> L
@inject ICampaignClientService CampaignService
@inject ConfirmService Confirm
@inject ToastService Toast
@inject IJSRuntime JS

<PageTitle>@L["Gm.Players.Title"] — RUPTURA</PageTitle>

<div class="page-content">
    <div class="page-heading">
        <h1>@L["Gm.Players.Title"]</h1>
    </div>

    @if (_loading)
    {
        <LoadingIndicator Text="@L["Common.Loading"]" />
    }
    else if (_players.Count == 0)
    {
        <div class="ledger-empty">
            <p>@L["Gm.Players.Empty"]</p>
        </div>
    }
    else
    {
        <TableSearchBox @bind-Value="_searchTerm" Placeholder="@L["Gm.Players.SearchPlaceholder"]" />

        @if (FilteredPlayers.Count == 0)
        {
            <div class="ledger-empty">
                <p>@L["Gm.Players.NoResults"]</p>
            </div>
        }
        else
        {
            <div class="ledger-table-wrap">
                <table class="ledger-table stack-mobile">
                    <thead>
                        <tr>
                            <th>@L["Gm.Players.Col.Name"]</th>
                            <th>@L["Gm.Players.Col.Email"]</th>
                            <th>@L["Gm.Players.Col.RecruitedAt"]</th>
                            <th>@L["Gm.Players.Col.Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var player in FilteredPlayers)
                        {
                            <tr>
                                <td data-label="@L["Gm.Players.Col.Name"]">@player.DisplayName</td>
                                <td data-label="@L["Gm.Players.Col.Email"]">@player.Email</td>
                                <td data-label="@L["Gm.Players.Col.RecruitedAt"]" style="color:var(--text-muted);font-size:var(--text-xs);white-space:nowrap">
                                    @player.RecruitedAt.ToLocalTime().ToString("dd/MM/yy HH:mm")
                                </td>
                                <td data-label="@L["Gm.Players.Col.Actions"]">
                                    <button type="button" class="btn btn-outline-secondary btn-sm"
                                            disabled="@(_resettingId == player.Id)"
                                            @onclick="() => ResetPasswordAsync(player)">
                                        @L["Gm.Players.ResetPassword"]
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</div>

@if (_tempPassword is not null)
{
    @* No click-outside-to-close: the password is shown once, so closing must be deliberate. *@
    <div class="confirm-overlay">
        <div class="confirm-box" role="dialog" aria-modal="true" aria-labelledby="temp-pw-title">
            <h2 class="confirm-title" id="temp-pw-title">@L["Gm.Players.TempPassword.Title"]</h2>
            <p class="confirm-message">@L["Gm.Players.TempPassword.Message", _tempPasswordPlayerName]</p>
            <code class="temp-password">@_tempPassword</code>
            <div class="confirm-actions">
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CopyTempPasswordAsync">
                    @L["Gm.Players.TempPassword.Copy"]
                </button>
                <button type="button" class="btn btn-primary btn-sm" @onclick="CloseTempPassword">
                    @L["Common.Close"]
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<PlayerRosterResponse> _players = [];
    private bool _loading = true;
    private string _searchTerm = string.Empty;
    private Guid? _resettingId;
    private string? _tempPassword;
    private string _tempPasswordPlayerName = string.Empty;

    private List<PlayerRosterResponse> FilteredPlayers =>
        _players.Where(p => TableFilter.Matches(_searchTerm, p.DisplayName, p.Email)).ToList();

    protected override async Task OnInitializedAsync()
    {
        var result = await CampaignService.GetRosterAsync();
        _players = result?.Data?.ToList() ?? [];
        _loading = false;
    }

    private async Task ResetPasswordAsync(PlayerRosterResponse player)
    {
        var confirmed = await Confirm.AskAsync(
            L["Gm.Players.ResetConfirm.Title"],
            L["Gm.Players.ResetConfirm.Message", player.DisplayName],
            L["Gm.Players.ResetConfirm.Confirm"],
            L["Gm.Players.ResetConfirm.Cancel"]);
        if (!confirmed) return;

        _resettingId = player.Id;
        try
        {
            var result = await CampaignService.ResetPlayerPasswordAsync(player.Id);
            if (result?.Data is null)
            {
                Toast.Error(L["Gm.Players.ResetError"]);
                return;
            }

            _tempPasswordPlayerName = player.DisplayName;
            _tempPassword = result.Data.TemporaryPassword;
        }
        finally
        {
            _resettingId = null;
        }
    }

    private async Task CopyTempPasswordAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _tempPassword);
            Toast.Success(L["Gm.Players.TempPassword.Copied"]);
        }
        catch (JSException)
        {
            // Clipboard API needs a secure context / permission; the password stays selectable.
            Toast.Error(L["Gm.Players.TempPassword.CopyFailed"]);
        }
    }

    private void CloseTempPassword()
    {
        _tempPassword = null;
        _tempPasswordPlayerName = string.Empty;
    }
}
