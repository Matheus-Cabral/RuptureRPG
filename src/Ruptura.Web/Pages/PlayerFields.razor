@using Microsoft.Extensions.Localization
@using Ruptura.Shared.Auth
@using Ruptura.Web.Resources

<div class="auth-field">
    <label class="form-label">@L["Register.DisplayName"]</label>
    <InputText class="form-control" @bind-Value="Model.DisplayName" autocomplete="name" />
    <ValidationMessage For="() => Model.DisplayName" />
</div>
<div class="auth-field">
    <label class="form-label">@L["Register.Email"]</label>
    <InputText class="form-control" @bind-Value="Model.Email" type="email" autocomplete="email" />
    <ValidationMessage For="() => Model.Email" />
</div>
<div class="auth-field">
    <label class="form-label">@L["Register.Password"]</label>
    <InputText class="form-control" @bind-Value="Model.Password" type="password" autocomplete="new-password" />
    <ValidationMessage For="() => Model.Password" />
</div>
<div class="auth-field">
    <label class="form-label">@L["Register.ConfirmPassword"]</label>
    <InputText class="form-control" @bind-Value="Model.ConfirmPassword" type="password" autocomplete="new-password" />
    <ValidationMessage For="() => Model.ConfirmPassword" />
</div>
<div class="auth-field">
    <label class="form-label">@L["Register.InviteCode"]</label>
    <InputText class="form-control" @bind-Value="Model.InviteCode"
               placeholder="@L["Register.InviteCodePlaceholder"]"
               style="font-family:var(--font-mono);letter-spacing:.1em;text-transform:uppercase" />
    <ValidationMessage For="() => Model.InviteCode" />
</div>

@code {
    [Parameter, EditorRequired] public RegisterPlayerRequest Model { get; set; } = null!;
    [Parameter, EditorRequired] public IStringLocalizer<AppStrings> L { get; set; } = null!;
}
