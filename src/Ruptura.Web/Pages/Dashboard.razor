@page "/dashboard"
@attribute [Authorize]
@using Microsoft.Extensions.Localization
@using Ruptura.Shared.Invites
@using Ruptura.Web.Resources
@inject IStringLocalizer<AppStrings> L
@inject IInviteClientService InviteService
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>@L["Dashboard.Title"] — RUPTURA</PageTitle>

<AuthorizeView Roles="GameMaster">
    <Authorized>
        <GmDashboard />
    </Authorized>
    <NotAuthorized>
        <PlayerDashboard />
    </NotAuthorized>
</AuthorizeView>
