@page "/dashboard"
@attribute [Authorize]
@using Microsoft.Extensions.Localization
@using Ruptura.Web.Resources
@inject IStringLocalizer<AppStrings> L

<PageTitle>@L["Dashboard.Title"] — RUPTURA</PageTitle>

<div class="page-content">
    <div class="page-heading">
        <h1>@L["Dashboard.Title"]</h1>
    </div>

    <AuthorizeView Roles="GameMaster">
        <Authorized><GmDashboard /></Authorized>
        <NotAuthorized><PlayerDashboard /></NotAuthorized>
    </AuthorizeView>
</div>
