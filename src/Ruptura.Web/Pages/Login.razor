@page "/login"
@attribute [AllowAnonymous]
@using Microsoft.Extensions.Localization
@using Ruptura.Shared.Auth
@using Ruptura.Web.Resources
@inject IStringLocalizer<AppStrings> L
@inject IAuthClientService AuthService
@inject NavigationManager Nav

<PageTitle>@L["Login.Title"] — RUPTURA</PageTitle>

<div class="auth-scene">
    <div class="auth-form-wrap">

        <div class="auth-logo">
            <span class="auth-logo-name">RUPTURA</span>
            <span class="auth-logo-rule"></span>
            <span class="auth-logo-sub">@L["Login.Title"]</span>
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert-danger mb-4">@_error</div>
        }

        <EditForm Model="_model" OnValidSubmit="HandleLogin">
            <DataAnnotationsValidator />

            <div class="auth-field">
                <label class="form-label">@L["Login.Email"]</label>
                <InputText class="form-control" @bind-Value="_model.Email" type="email"
                           autocomplete="email" />
                <ValidationMessage For="() => _model.Email" />
            </div>

            <div class="auth-field">
                <label class="form-label">@L["Login.Password"]</label>
                <InputText class="form-control" @bind-Value="_model.Password" type="password"
                           autocomplete="current-password" />
                <ValidationMessage For="() => _model.Password" />
            </div>

            <div class="auth-actions">
                <button type="submit" class="btn btn-primary" disabled="@_loading">
                    @if (_loading) { <span class="spinner-border spinner-border-sm me-2"></span> }
                    @L["Login.Submit"]
                </button>
            </div>
        </EditForm>

        <div class="auth-footer">
            @L["Login.NoAccount"] <a href="/register">@L["Nav.Register"]</a>
        </div>

    </div>
</div>

@code {
    private readonly LoginRequest _model = new();
    private string? _error;
    private bool _loading;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private async Task HandleLogin()
    {
        _loading = true;
        _error = null;

        var result = await AuthService.LoginAsync(_model);

        if (result?.Data is not null)
            Nav.NavigateTo(ReturnUrl ?? "/dashboard");
        else
            _error = result?.Message ?? L["Login.Error"];

        _loading = false;
    }
}
