@using Microsoft.Extensions.Localization
@using Ruptura.Web.Resources
@using Ruptura.Shared.Guilds
@using Ruptura.Shared.Catalog
@inject IStringLocalizer<AppStrings> L
@inject ICatalogClientService CatalogService

<div style="display:flex;flex-direction:column;gap:1rem;max-width:480px">
    <div>
        <label class="form-label">@L["Guild.Identity.PatronDeity"]</label>
        <input class="form-control" @bind="Data.Identity.PatronDeity" @bind:event="oninput" />
    </div>
    <div>
        <label class="form-label">@L["Guild.Identity.MainDoctrine"]</label>
        <select class="form-select" value="@Data.Identity.MainDoctrineId" @onchange="e => Data.Identity.MainDoctrineId = ParseGuid(e.Value)">
            <option value="">@L["Sheet.Identity.None"]</option>
            @foreach (var entry in _doctrineOptions)
            {
                <option value="@entry.Id">@entry.Name</option>
            }
        </select>
    </div>
    <div>
        <label class="form-label">@L["Guild.Identity.FoundingDate"]</label>
        <input type="date" class="form-control" @bind="Data.Identity.FoundingDate" />
    </div>
    <div>
        <label class="form-label">@L["Guild.Identity.Ranking"]</label>
        <select class="form-select" @bind="Data.Identity.GuildRanking">
            @foreach (var (value, key) in Ranks)
            {
                <option value="@value">@L[key]</option>
            }
        </select>
    </div>
</div>

@code {
    [Parameter] public GuildSheetData Data { get; set; } = new();
    [Parameter] public Guid CampaignId { get; set; }

    // 8 GDD ranks (stored value, localization key). ASCII keys avoid accents in resx names.
    private static readonly (string Value, string Key)[] Ranks =
    [
        ("Bronze", "Guild.Rank.Bronze"),
        ("Ferro", "Guild.Rank.Ferro"),
        ("Aço", "Guild.Rank.Aco"),
        ("Prata", "Guild.Rank.Prata"),
        ("Ouro", "Guild.Rank.Ouro"),
        ("Mithril", "Guild.Rank.Mithril"),
        ("Adamante", "Guild.Rank.Adamante"),
        ("Lendário", "Guild.Rank.Lendario")
    ];

    // Full list (incl. archived) fetched once; keep the currently-selected doctrine visible
    // even if archived so its option matches (same pattern as the character sheet pickers).
    private List<CatalogEntryResponse> _doctrines = [];

    private IEnumerable<CatalogEntryResponse> _doctrineOptions =>
        _doctrines.Where(e => !e.IsArchived || e.Id == Data.Identity.MainDoctrineId);

    protected override async Task OnInitializedAsync()
    {
        _doctrines = (await CatalogService.GetByTypeAsync("Doctrine", CampaignId, includeArchived: true))?.Data?.ToList() ?? [];
    }

    private static Guid? ParseGuid(object? value) =>
        Guid.TryParse(value?.ToString(), out var id) ? id : null;
}
