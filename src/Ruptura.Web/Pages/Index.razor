@page "/"
@attribute [AllowAnonymous]
@using Microsoft.Extensions.Localization
@using Ruptura.Web.Resources
@inject IStringLocalizer<AppStrings> L

<PageTitle>RUPTURA</PageTitle>

<div class="landing">

    <!-- Hero -->
    <section class="landing-hero">
        <div class="hero-inner">
            <span class="hero-rule"></span>
            <h1 class="hero-title">RUPTURA</h1>
            <span class="hero-rule"></span>
            <p class="hero-subtitle">@L["Landing.Hero.Subtitle"]</p>
            <p class="hero-desc">@L["Landing.Hero.Concept"]</p>
            <div class="hero-links">
                <a href="/register" class="hero-link primary">@L["Landing.Hero.GetStarted"]</a>
                <a href="/login" class="hero-link">@L["Landing.Hero.SignIn"]</a>
            </div>
        </div>
    </section>

    <!-- Pillars -->
    <section class="landing-pillars">
        <div class="pillars-header">
            <span class="pillars-eyebrow">@L["Landing.Pillars.Eyebrow"]</span>
            <h2 class="pillars-heading">@L["Landing.Pillars.Title"]</h2>
        </div>
        <div class="pillars-grid">
            <div class="pillar-item">
                <div class="pillar-title">@L["Landing.Pillars.Lethality.Title"]</div>
                <p class="pillar-desc">@L["Landing.Pillars.Lethality.Desc"]</p>
            </div>
            <div class="pillar-item">
                <div class="pillar-title">@L["Landing.Pillars.Persistent.Title"]</div>
                <p class="pillar-desc">@L["Landing.Pillars.Persistent.Desc"]</p>
            </div>
            <div class="pillar-item">
                <div class="pillar-title">@L["Landing.Pillars.Guild.Title"]</div>
                <p class="pillar-desc">@L["Landing.Pillars.Guild.Desc"]</p>
            </div>
            <div class="pillar-item">
                <div class="pillar-title">@L["Landing.Pillars.NoXP.Title"]</div>
                <p class="pillar-desc">@L["Landing.Pillars.NoXP.Desc"]</p>
            </div>
            <div class="pillar-item">
                <div class="pillar-title">@L["Landing.Pillars.Interlude.Title"]</div>
                <p class="pillar-desc">@L["Landing.Pillars.Interlude.Desc"]</p>
            </div>
            <div class="pillar-item">
                <div class="pillar-title">@L["Landing.Pillars.Info.Title"]</div>
                <p class="pillar-desc">@L["Landing.Pillars.Info.Desc"]</p>
            </div>
        </div>
    </section>

    <!-- Quote -->
    <section class="landing-quote">
        <blockquote>@L["Landing.Quote"]</blockquote>
    </section>

    <!-- CTA -->
    <section class="landing-cta">
        <h2>@L["Landing.CTA.Title"]</h2>
        <p>@L["Landing.CTA.Desc"]</p>
        <a href="/register" class="btn btn-primary">@L["Landing.CTA.Button"]</a>
    </section>

</div>
