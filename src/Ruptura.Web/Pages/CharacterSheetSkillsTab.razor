@using Microsoft.Extensions.Localization
@using Ruptura.Web.Resources
@using Ruptura.Shared.CharacterSheets
@using Ruptura.Shared.Catalog
@inject IStringLocalizer<AppStrings> L
@inject ICatalogClientService CatalogService

@if (_loading)
{
    <LoadingIndicator Text="@L["Common.Loading"]" />
}
else
{
<div class="master-detail">
    <div class="master-detail-list">
        <div class="ledger-table-wrap">
            <table class="ledger-table stack-mobile">
                <thead>
                    <tr>
                        <th>@L["Gm.CampaignDetail.Col.Name"]</th>
                        <th>@L["Sheet.Skills.Points"]</th>
                        <th>@L["Sheet.Skills.Grade"]</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var skill in Data.Skills)
                    {
                        <tr class="@(_selectedRefId == skill.CatalogEntryId ? "is-selected" : null)"
                            tabindex="0" role="button"
                            @onclick="() => _selectedRefId = skill.CatalogEntryId"
                            @onkeydown="e => OnRowKey(e, skill.CatalogEntryId)">
                            <td data-label="@L["Gm.CampaignDetail.Col.Name"]">@NameOf(skill.CatalogEntryId)</td>
                            <td data-label="@L["Sheet.Skills.Points"]" style="width:100px" @onclick:stopPropagation="true">
                                <input class="form-control form-control-sm" type="number" min="0"
                                       value="@skill.Points" @onchange="e => skill.Points = ParseInt(e.Value)" />
                            </td>
                            <td data-label="@L["Sheet.Skills.Grade"]">@Derived?.SkillGradeBonuses.GetValueOrDefault(skill.CatalogEntryId)</td>
                            <td data-label="" @onclick:stopPropagation="true"><button class="btn btn-outline-secondary btn-sm" @onclick="() => RemoveSkill(skill)">@L["Sheet.Skills.Remove"]</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="detail-panel">
        @{
            var sel = _all.FirstOrDefault(e => e.Id == _selectedRefId);
        }
        @if (sel is null)
        {
            <p class="detail-panel-empty">@L["Detail.SelectItem"]</p>
        }
        else
        {
            <h3>@sel.Name</h3>
            <JsonDetailView Json="@sel.DataJson" />
        }
    </div>
</div>

<div style="display:flex;gap:.5rem;margin-top:1rem">
    <select class="form-select" style="max-width:320px" @bind="_selectedSkillId">
        @foreach (var entry in _available)
        {
            <option value="@entry.Id">@entry.Name</option>
        }
    </select>
    <button class="btn btn-primary btn-sm" @onclick="AddSkill" disabled="@(_selectedSkillId == Guid.Empty)">@L["Sheet.Skills.Add"]</button>
</div>
}

@code {
    [Parameter] public CharacterSheetData Data { get; set; } = new();
    [Parameter] public CharacterDerivedStats? Derived { get; set; }
    [Parameter] public Guid CampaignId { get; set; }

    // Full list (including archived) — used for resolving the NAME of an already-referenced
    // skill, so an archived-but-invested skill still shows its real name instead of a raw GUID.
    private List<CatalogEntryResponse> _all = [];
    private Guid _selectedSkillId;
    private Guid? _selectedRefId;
    private bool _loading = true;

    // A user must never be able to newly add an archived skill — only offer non-archived
    // entries that aren't already invested in.
    private IEnumerable<CatalogEntryResponse> _available =>
        _all.Where(e => !e.IsArchived && Data.Skills.All(s => s.CatalogEntryId != e.Id));

    protected override async Task OnInitializedAsync()
    {
        _all = (await CatalogService.GetByTypeAsync("Skill", CampaignId, includeArchived: true))?.Data?.ToList() ?? [];
        _loading = false;
    }

    private string NameOf(Guid id) => _all.FirstOrDefault(e => e.Id == id)?.Name ?? id.ToString();

    private void OnRowKey(KeyboardEventArgs e, Guid refId)
    {
        if (e.Key == "Enter" || e.Key == " ") _selectedRefId = refId;
    }

    private static int ParseInt(object? value) => int.TryParse(value?.ToString(), out var v) ? v : 0;

    private void AddSkill()
    {
        if (_selectedSkillId == Guid.Empty) return;
        Data.Skills.Add(new CharacterSkillEntry { CatalogEntryId = _selectedSkillId, Points = 0 });
        _selectedSkillId = Guid.Empty;
    }

    // Removing an invested Skill must also clear any equipped weapon's LinkedSkillEntryId that
    // pointed at it — otherwise the weapon table silently falls back to the untrained (−2) grade
    // via a dangling reference instead of showing the link was lost. See Finding 2(iii).
    private void RemoveSkill(CharacterSkillEntry skill)
    {
        Data.Skills.Remove(skill);
        if (_selectedRefId == skill.CatalogEntryId) _selectedRefId = null;
        foreach (var item in Data.Equipment.Where(e => e.LinkedSkillEntryId == skill.CatalogEntryId))
            item.LinkedSkillEntryId = null;
    }
}
