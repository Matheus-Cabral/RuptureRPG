@using Microsoft.Extensions.Localization
@using Ruptura.Web.Resources
@using Ruptura.Shared.CharacterSheets
@using Ruptura.Shared.Catalog
@inject IStringLocalizer<AppStrings> L
@inject ICatalogClientService CatalogService

@if (_loading)
{
    <LoadingIndicator Text="@L["Common.Loading"]" />
}
else
{
<div style="display:flex;flex-wrap:wrap;gap:1.5rem;margin-bottom:1.5rem">
    <div><span class="section-title" style="display:block">@L["Sheet.Equipment.CarryCapacity"]</span><span>@Derived?.CarryCapacity</span></div>
    <div><span class="section-title" style="display:block">@L["Sheet.Equipment.CurrentWeight"]</span><span>@Derived?.CurrentWeight</span></div>
    <div>
        <label class="form-label" style="display:block">@L["Sheet.Equipment.Silver"]</label>
        <input class="form-control" type="number" min="0"
               value="@Data.Currency.Silver" @onchange="e => Data.Currency.Silver = ParseInt(e.Value, 0)" style="width:120px" />
    </div>
    <div>
        <label class="form-label" style="display:block">@L["Sheet.Equipment.PactCoins"]</label>
        <input class="form-control" type="number" min="0"
               value="@Data.Currency.PactCoins" @onchange="e => Data.Currency.PactCoins = ParseInt(e.Value, 0)" style="width:120px" />
    </div>
</div>

<div class="master-detail">
    <div class="master-detail-list">
        <div class="ledger-table-wrap">
            <table class="ledger-table stack-mobile">
                <thead>
                    <tr>
                        <th>@L["Gm.CampaignDetail.Col.Name"]</th>
                        <th>@L["Sheet.Equipment.Category"]</th>
                        <th>@L["Sheet.Equipment.Quantity"]</th>
                        <th>@L["Sheet.Equipment.Durability"]</th>
                        <th>@L["Sheet.Equipment.Equipped"]</th>
                        <th>@L["Sheet.Equipment.LinkedSkill"]</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Data.Equipment)
                    {
                        <tr class="@(_selectedRefId == item.CatalogEntryId ? "is-selected" : null)"
                            tabindex="0" role="button"
                            @onclick="() => _selectedRefId = item.CatalogEntryId"
                            @onkeydown="e => OnRowKey(e, item.CatalogEntryId)">
                            <td data-label="@L["Gm.CampaignDetail.Col.Name"]">@NameOf(item.CatalogEntryId)</td>
                            <td data-label="@L["Sheet.Equipment.Category"]">@CategoryLabelOf(item.CatalogEntryId)</td>
                            <td data-label="@L["Sheet.Equipment.Quantity"]" style="width:80px" @onclick:stopPropagation="true">
                                <input class="form-control form-control-sm" type="number" min="1"
                                       value="@item.Quantity" @onchange="e => item.Quantity = ParseInt(e.Value, 1)" />
                            </td>
                            <td data-label="@L["Sheet.Equipment.Durability"]" style="width:100px" @onclick:stopPropagation="true">
                                <input class="form-control form-control-sm" type="number" min="0"
                                       value="@item.DurabilityRemaining" @onchange="e => item.DurabilityRemaining = ParseInt(e.Value, 0)" />
                            </td>
                            <td data-label="@L["Sheet.Equipment.Equipped"]" @onclick:stopPropagation="true"><input type="checkbox" checked="@item.IsEquipped" @onchange="e => item.IsEquipped = (bool)(e.Value ?? false)" /></td>
                            <td data-label="@L["Sheet.Equipment.LinkedSkill"]" @onclick:stopPropagation="true">
                                <select class="form-select form-select-sm" value="@item.LinkedSkillEntryId"
                                        @onchange="e => item.LinkedSkillEntryId = ParseGuid(e.Value)">
                                    <option value="">@L["Sheet.Equipment.NoneSkill"]</option>
                                    @foreach (var skill in _skills)
                                    {
                                        <option value="@skill.CatalogEntryId">@SkillNameOf(skill.CatalogEntryId)</option>
                                    }
                                </select>
                            </td>
                            <td data-label="" @onclick:stopPropagation="true"><button class="btn btn-outline-secondary btn-sm" @onclick="() => RemoveItem(item)">@L["Sheet.RefList.Remove"]</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="detail-panel">
        @{
            var sel = _allItems.FirstOrDefault(e => e.Id == _selectedRefId);
        }
        @if (sel is null)
        {
            <p class="detail-panel-empty">@L["Detail.SelectItem"]</p>
        }
        else
        {
            <h3>@sel.Name</h3>
            <JsonDetailView Json="@sel.DataJson" />
        }
    </div>
</div>

<div style="display:flex;gap:.5rem;margin-top:1rem">
    <select class="form-select" style="max-width:320px" @bind="_selectedId">
        @foreach (var entry in _availableItems)
        {
            <option value="@entry.Id">@entry.Name</option>
        }
    </select>
    <button class="btn btn-primary btn-sm" @onclick="AddItem" disabled="@(_selectedId == Guid.Empty)">@L["Sheet.RefList.Add"]</button>
</div>
}

@code {
    [Parameter] public CharacterSheetData Data { get; set; } = new();
    [Parameter] public CharacterDerivedStats? Derived { get; set; }
    [Parameter] public Guid CampaignId { get; set; }

    // Full lists (including archived) — used for resolving the NAME of an already-referenced
    // item/skill, so an archived-but-referenced entry still shows its real name instead of a
    // raw GUID. The linked-skill <select>'s OPTIONS themselves come from Data.Skills (the
    // character's own invested skills), not this catalog list, so they need no archived
    // filtering — only SkillNameOf's lookup does.
    private List<CatalogEntryResponse> _allItems = [];
    private List<CharacterSkillEntry> _skills => Data.Skills;
    private List<CatalogEntryResponse> _skillCatalog = [];
    private Guid _selectedId;
    private Guid? _selectedRefId;
    private bool _loading = true;

    // A user must never be able to newly equip an archived item.
    private IEnumerable<CatalogEntryResponse> _availableItems => _allItems.Where(e => !e.IsArchived);

    protected override async Task OnInitializedAsync()
    {
        _allItems = (await CatalogService.GetByTypeAsync("EquipmentItem", CampaignId, includeArchived: true))?.Data?.ToList() ?? [];
        _skillCatalog = (await CatalogService.GetByTypeAsync("Skill", CampaignId, includeArchived: true))?.Data?.ToList() ?? [];
        _loading = false;
    }

    private string NameOf(Guid id) => _allItems.FirstOrDefault(e => e.Id == id)?.Name ?? id.ToString();
    private string SkillNameOf(Guid id) => _skillCatalog.FirstOrDefault(e => e.Id == id)?.Name ?? id.ToString();

    // Same case/whitespace-insensitive matching as CharacterStatsCalculator.CategoryIs, so the
    // label shown here always agrees with what actually counted in the combat math below. An
    // unrecognized value (legacy data saved before the catalog form had a Category dropdown) is
    // shown as-is rather than hidden, so a GM can spot and fix it instead of it silently vanishing.
    private string CategoryLabelOf(Guid id)
    {
        var raw = CatalogEntryData.Parse(_allItems.FirstOrDefault(e => e.Id == id)?.DataJson).GetString("Category").Trim();
        return raw.ToLowerInvariant() switch
        {
            "arma" => L["Gm.Catalog.EquipmentCategory.Weapon"].Value,
            "armadura" => L["Gm.Catalog.EquipmentCategory.Armor"].Value,
            "escudo" => L["Gm.Catalog.EquipmentCategory.Shield"].Value,
            "item" => L["Gm.Catalog.EquipmentCategory.Item"].Value,
            _ => raw
        };
    }

    private void OnRowKey(KeyboardEventArgs e, Guid refId)
    {
        if (e.Key == "Enter" || e.Key == " ") _selectedRefId = refId;
    }

    private void RemoveItem(CharacterEquipmentEntry item)
    {
        Data.Equipment.Remove(item);
        if (_selectedRefId == item.CatalogEntryId) _selectedRefId = null;
    }

    private static int ParseInt(object? value, int fallback) => int.TryParse(value?.ToString(), out var v) ? v : fallback;
    private static Guid? ParseGuid(object? value) => Guid.TryParse(value?.ToString(), out var id) ? id : null;

    private void AddItem()
    {
        if (_selectedId == Guid.Empty) return;
        Data.Equipment.Add(new CharacterEquipmentEntry { CatalogEntryId = _selectedId, Quantity = 1 });
        _selectedId = Guid.Empty;
    }
}
