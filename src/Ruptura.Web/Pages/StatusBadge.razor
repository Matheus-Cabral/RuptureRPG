@using Microsoft.Extensions.Localization
@using Ruptura.Shared.Invites
@using Ruptura.Web.Resources
@inject IStringLocalizer<AppStrings> L

@if (Code.IsUsed)
{
    <span class="badge-status badge-used">@L["Gm.Invites.Status.Used"]</span>
}
else if (Code.ExpiresAt <= DateTime.UtcNow)
{
    <span class="badge-status badge-expired">@L["Gm.Invites.Status.Expired"]</span>
}
else
{
    <span class="badge-status badge-active">@L["Gm.Invites.Status.Active"]</span>
}

@code {
    [Parameter, EditorRequired] public InviteCodeResponse Code { get; set; } = null!;
}
