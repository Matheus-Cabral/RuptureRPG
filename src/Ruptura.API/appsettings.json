{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=db;Port=5432;Database=ruptura;Username=ruptura;Password=changeme"
  },
  "JwtSettings": {
    "SecretKey": "CHANGE_ME_TO_A_STRONG_SECRET_KEY_AT_LEAST_32_CHARS",
    "Issuer": "RupturaAPI",
    "Audience": "RupturaClient",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "MediaSettings": {
    "RootPath": "/app/media",
    "MaxFileSizeMb": 5,
    "MaxImagesPerJournalEntry": 6
  },
  "Cors": {
    "AllowedOrigin": "http://localhost"
  },
  "AllowedHosts": "*"
}
