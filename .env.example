# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=ruptura
POSTGRES_USER=ruptura
POSTGRES_PASSWORD=change_me_strong_password

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Must be at least 32 characters for HMAC-SHA256
JWT_SECRET_KEY=change_me_to_a_very_strong_secret_key_at_least_32_chars
JWT_ISSUER=RupturaAPI
JWT_AUDIENCE=RupturaClient
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# ─── CORS / URLs ──────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGIN=http://localhost

# URL used by Blazor WASM in the browser to call the API
API_BASE_URL=http://localhost:5000

# ─── Ports ────────────────────────────────────────────────────────────────────
API_PORT=5000
WEB_PORT=80

# ─── ASP.NET Core ─────────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production
