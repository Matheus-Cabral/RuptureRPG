# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=ruptura
POSTGRES_USER=ruptura
POSTGRES_PASSWORD=change_me_strong_password

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Must be at least 32 characters for HMAC-SHA256
JWT_SECRET_KEY=change_me_to_a_very_strong_secret_key_at_least_32_chars
JWT_ISSUER=RupturaAPI
JWT_AUDIENCE=RupturaClient
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# ─── Ports ────────────────────────────────────────────────────────────────────
API_PORT=5000
WEB_PORT=80

# ─── CORS / URLs ──────────────────────────────────────────────────────────────
# ⚠️  CORS_ALLOWED_ORIGIN must match the URL you use to open the app in the browser.
#    Format: http://localhost:<WEB_PORT>
#    If WEB_PORT=80  → CORS_ALLOWED_ORIGIN=http://localhost
#    If WEB_PORT=81  → CORS_ALLOWED_ORIGIN=http://localhost:81
#    Mismatch = browser blocks every API call (preflight returns no Access-Control-Allow-Origin).
CORS_ALLOWED_ORIGIN=http://localhost

# URL used by Blazor WASM *in the browser* to reach the API.
# Must be accessible from the user's machine (not Docker-internal hostname).
# Format: http://localhost:<API_PORT>
API_BASE_URL=http://localhost:5000

# ─── ASP.NET Core ─────────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production
