# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=ruptura
POSTGRES_USER=ruptura
POSTGRES_PASSWORD=change_me_strong_password

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Must be at least 32 characters for HMAC-SHA256
JWT_SECRET_KEY=change_me_to_a_very_strong_secret_key_at_least_32_chars
JWT_ISSUER=RupturaAPI
JWT_AUDIENCE=RupturaClient
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# ─── Ports ────────────────────────────────────────────────────────────────────
API_PORT=5000
WEB_PORT=80

# ─── CORS / URLs ──────────────────────────────────────────────────────────────
# ⚠️  CORS_ALLOWED_ORIGIN must match every URL the browser uses to open the app.
#    Supports comma-separated values for multiple environments.
#
#  Scenario A — everything in Docker (default):
#    CORS_ALLOWED_ORIGIN=http://localhost          (when WEB_PORT=80)
#    CORS_ALLOWED_ORIGIN=http://localhost:81       (when WEB_PORT=81)
#
#  Scenario B — API in Docker, Blazor in dev server (dotnet run / IDE):
#    Dev server always runs on http://localhost:5186 (see launchSettings.json).
#    CORS_ALLOWED_ORIGIN=http://localhost:5186
#
#  Scenario C — both at the same time:
#    CORS_ALLOWED_ORIGIN=http://localhost,http://localhost:5186
CORS_ALLOWED_ORIGIN=http://localhost

# URL used by Blazor WASM *in the browser* to reach the API.
# In Docker: http://localhost:<API_PORT>  (browser → host → Docker)
# In dev (dotnet run on API): http://localhost:5001  (or whatever dotnet run uses)
# Default matches the Docker API container.
API_BASE_URL=http://localhost:5000

# ─── ASP.NET Core ─────────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production

# ─── Media Storage ────────────────────────────────────────────────────────────
# Max upload size in MB and max images per journal entry. 0 = unlimited.
MEDIA_MAX_FILE_SIZE_MB=5
MEDIA_MAX_IMAGES_PER_ENTRY=6
